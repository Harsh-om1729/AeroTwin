# AI Maintenance Copilot (optional). Copy this file to `.env` and add a key.
# Without any key the copilot still works in offline mode.
# Providers are tried in order Gemini -> Claude -> offline engine
# (set COPILOT_PROVIDER=claude to try Claude first).

# Google Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# COPILOT_MODEL_GEMINI=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash   (tried in this order)

# Anthropic Claude: key from https://console.anthropic.com (API billing is separate from a claude.ai subscription)
ANTHROPIC_API_KEY=
# COPILOT_MODEL=claude-opus-5-5
# COPILOT_EFFORT=medium
